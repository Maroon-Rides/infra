{
  "uid": "maroonrides-api",
  "title": "MaroonRides API",
  "tags": ["maroonrides"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 41,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "type": "row", "title": "Gateway", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    {
      "type": "stat", "title": "Requests/s",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } },
      "targets": [{ "refId": "A", "expr": "sum(rate(gateway_http_requests_total[$__rate_interval]))" }]
    },
    {
      "type": "stat", "title": "5xx ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ] }
        }
      },
      "targets": [{ "refId": "A", "expr": "sum(rate(gateway_http_requests_total{status=~\"5..\"}[$__rate_interval])) / sum(rate(gateway_http_requests_total[$__rate_interval])) or vector(0)" }]
    },
    {
      "type": "stat", "title": "Websocket clients",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "targets": [{ "refId": "A", "expr": "sum(gateway_websocket_clients)" }]
    },
    {
      "type": "stat", "title": "Subscribed routes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "targets": [{ "refId": "A", "expr": "sum(gateway_websocket_subscribed_routes)" }]
    },
    {
      "type": "timeseries", "title": "Requests by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "expr": "sum by (route) (rate(gateway_http_requests_total[$__rate_interval]))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries", "title": "Requests by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(gateway_http_requests_total[$__rate_interval]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "p95 latency by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(gateway_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries", "title": "Websocket messages",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(gateway_websocket_messages_sent_total[$__rate_interval]))", "legendFormat": "sent" },
        { "refId": "B", "expr": "sum(rate(gateway_websocket_send_failures_total[$__rate_interval]))", "legendFormat": "dropped" }
      ]
    },
    {
      "type": "timeseries", "title": "Syncs by kind",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [{ "refId": "A", "expr": "sum by (kind) (rate(gateway_syncs_total[$__rate_interval]))", "legendFormat": "{{kind}}" }]
    },
    {
      "type": "timeseries", "title": "Time since previous sync (median, p90)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(gateway_sync_interval_seconds_bucket[$__rate_interval])))", "legendFormat": "median" },
        { "refId": "B", "expr": "histogram_quantile(0.9, sum by (le) (rate(gateway_sync_interval_seconds_bucket[$__rate_interval])))", "legendFormat": "p90" }
      ]
    },

    { "type": "row", "title": "Requester", "collapsed": false, "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 } },
    {
      "type": "timeseries", "title": "Job attempts by result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [{ "refId": "A", "expr": "sum by (job, result) (rate(requester_job_runs_total[$__rate_interval]))", "legendFormat": "{{job}} {{result}}" }]
    },
    {
      "type": "timeseries", "title": "Job runs out of retries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "bars" } } },
      "targets": [{ "refId": "A", "expr": "sum by (job) (increase(requester_job_retries_exhausted_total[$__rate_interval]))", "legendFormat": "{{job}}" }]
    },
    {
      "type": "timeseries", "title": "p95 job attempt duration",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(requester_job_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{job}}" }]
    },
    {
      "type": "timeseries", "title": "Upstream requests by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "expr": "sum by (upstream, status) (rate(requester_upstream_requests_total[$__rate_interval]))", "legendFormat": "{{upstream}} {{status}}" }]
    },
    {
      "type": "timeseries", "title": "p95 upstream latency by path",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 46, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, upstream, path) (rate(requester_upstream_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{upstream}} {{path}}" }]
    },

    { "type": "row", "title": "Runtime", "collapsed": false, "gridPos": { "x": 0, "y": 54, "w": 24, "h": 1 } },
    {
      "type": "timeseries", "title": "CPU by pod",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 55, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "refId": "A", "expr": "rate(process_cpu_seconds_total{namespace=\"maroonrides\"}[$__rate_interval])", "legendFormat": "{{pod}}" }]
    },
    {
      "type": "timeseries", "title": "Memory by pod",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 55, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes{namespace=\"maroonrides\"}", "legendFormat": "{{pod}}" }]
    },
    {
      "type": "timeseries", "title": "Goroutines by pod",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 55, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "go_goroutines{namespace=\"maroonrides\"}", "legendFormat": "{{pod}}" }]
    }
  ]
}
